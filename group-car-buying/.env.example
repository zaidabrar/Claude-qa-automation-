# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/groupcar

# Session signing secret (>= 32 chars). Generate: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# OTP delivery: "console" (logs OTP to the server log; dev only) or "msg91"
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# PAN verification: "format" (format + uniqueness only; dev) or plug in a KYC vendor in src/lib/pan.ts
PAN_PROVIDER=format

# Razorpay. Leave blank to use the built-in mock checkout (dev only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Booking token in rupees (refundable unless the buyer backs out after locking in)
BOOKING_TOKEN_INR=5000

# Protects /api/cron/sweep (expiry, bid close). Call it every few minutes from a scheduler.
CRON_SECRET=change-me
