# No LLM key needed: GitHub Copilot (your existing licence) is the agent.

# Jira Cloud (API token: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_EMAIL=
JIRA_API_TOKEN=

# Sauce Labs (User settings -> Access key)
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
# SAUCE_TUNNEL_NAME=   # if the app talks to a staging backend behind Sauce Connect

# Optional: lets open_pull_request create the PR (contents + pull_requests: write).
# Without it the tool pushes the branch and returns a compare link.
GITHUB_TOKEN=

# Optional
SLACK_WEBHOOK_URL=
